# PostgreSQL Container Configuration Example
POSTGRES_DB=devops_monitor
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Connection String
DATABASE_URL=postgresql://devops_user:your_secure_password_here@localhost:5432/devops_monitor

# Monitoring Alert Thresholds
ALERT_CPU_THRESHOLD=90.0
ALERT_MEMORY_THRESHOLD=90.0
ALERT_DISK_THRESHOLD=90.0
ALERT_RESPONSE_TIME_THRESHOLD_MS=1000.0
